{
  "name": "@niq-ai/workers",
  "version": "0.1.0",
  "description": "A collection of niq Workers — interesting, useful workers that live outside the core niq runtime. Each worker is importable as a subpath (e.g. @niq-ai/workers/lark).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niq-run/workers.git"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "niq-worker": "./start-worker.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hello": {
      "types": "./dist/hello/index.d.ts",
      "import": "./dist/hello/index.js"
    },
    "./lark": {
      "types": "./dist/lark/index.d.ts",
      "import": "./dist/lark/index.js"
    }
  },
  "files": [
    "dist",
    "start-worker.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@larksuite/channel": "^0.6.0",
    "@niq.run/worker-sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
